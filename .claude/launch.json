{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "investor-pitch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "-l", "4000"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend\\venv\\Scripts\\python.exe",
      "runtimeArgs": ["backend\\run_dev.py"],
      "port": 5000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web", "--", "--port", "8082"],
      "port": 8082
    }
  ]
}
