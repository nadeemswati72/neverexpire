ANTHROPIC_API_KEY=your-key-here
SECRET_KEY=change-this-in-production
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Gmail SMTP for PoC email reminders — use an App Password, not your real Gmail password.
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Google Drive storage for new document uploads (encrypted). Also requires
# data/google_client_secret.json and a one-time run of setup_google_drive_auth.py.
STORAGE_BACKEND=local
ENCRYPTION_KEY=generate-with-Fernet.generate_key()
