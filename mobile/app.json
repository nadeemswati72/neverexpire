{
  "expo": {
    "name": "NeverExpire",
    "slug": "neverexpire-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.neverexpire.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "NeverExpire needs access to your photos to attach document images.",
          "cameraPermission": "NeverExpire needs camera access to scan documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NeverExpire needs camera access to scan documents."
        }
      ]
    ]
  }
}
